<mvc:View
    controllerName="customerindent.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page showHeader="false" class="portalHomePage" enableScrolling="false">
        <content>
            <core:HTML content="&lt;video autoplay muted loop playsinline class=&quot;portal-bg-video&quot;&gt;&lt;source src=&quot;img/Untitled%20design.mp4&quot; type=&quot;video/mp4&quot;&gt;&lt;/video&gt;&lt;div class=&quot;portal-bg-overlay&quot;&gt;&lt;/div&gt;" />
            <VBox
                height="100%"
                justifyContent="Start"
                alignItems="Start"
                class="sapUiSmallMarginTop portalHomeContent">

                <HBox width="100%" justifyContent="SpaceBetween" alignItems="Start" class="sapUiMediumMarginBottom portalTopBar">
                    <HBox alignItems="Center">
                        <Image src="img/logo.png" alt="Logo" height="5rem" class="sapUiSmallMarginEnd" />
                        <VBox class="portalLogoText">
                            <Title text="Customer Indent Portal" level="H1" />
                            <Text text="Select an application to continue" />
                        </VBox>
                    </HBox>
                    <VBox justifyContent="Center" alignItems="End" class="portalSignOutArea">
                        <Text id="loggedInUser" text="" class="portalUserLabel" />
                        <Button
                            text="Sign Out"
                            icon="sap-icon://log"
                            type="Transparent"
                            class="portalSignOutBtn"
                            press=".onSignOut" />
                    </VBox>
                </HBox>

                <HBox wrap="Wrap" justifyContent="Start" class="sapUiMediumMarginTop">

                    <!-- Tile 1: Bulk Indent Portal -->
                    <GenericTile
                        class="portalTile sapUiSmallMarginEnd sapUiSmallMarginBottom"
                        header="Bulk Indent Portal"
                        subheader="Manage Bulk Indents"
                        press=".onBulkIndentPress"
                        frameType="TwoByOne">
                        <tileContent>
                            <TileContent footer="For bulk indents without/without third party agents">
                                <content>
                                    <ImageContent src="sap-icon://sales-order" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                    <!-- Tile 2: Direct Customer Indent (WebDynpro) -->
                    <GenericTile
                        class="portalTile portalTileAccent sapUiSmallMarginEnd sapUiSmallMarginBottom"
                        header="Direct Customer Indent"
                        subheader="For Direct Indents with Vehicles"
                        press=".onDirectIndentPress"
                        frameType="TwoByOne">
                        <tileContent>
                            <TileContent footer="Existing Portal">
                                <content>
                                    <ImageContent src="sap-icon://add-document" />
                                </content>
                            </TileContent>
                        </tileContent>
                    </GenericTile>

                </HBox>

            </VBox>
        </content>
    </Page>
</mvc:View>
